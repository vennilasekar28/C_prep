{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch prach_zc",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/prach_zc",
      "args": [],

      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,

      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",

      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],

      "logging": {
        "trace": false,
        "traceResponse": false,
        "engineLogging": false
      }
    }
  ]
}
